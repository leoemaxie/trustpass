# TrustPass Environment Configuration Example
# Copy this file to .env before starting services: cp .env.example .env
# Never commit real secrets or key material to version control.

# Core Cryptographic Service (Rust)
PORT_CORE=50051
DEFAULT_ISSUER_SEED=13374242

# Go Application Services
PORT_SCHEMA_REGISTRY=8081
PORT_ISSUER_API=8082
PORT_VERIFIER_API=8083
PORT_RECEIPT_SERVICE=8084

# Service Inter-communication URLs
CORE_API_URL=http://localhost:50051
SCHEMA_REGISTRY_URL=http://localhost:8081
ISSUER_API_URL=http://localhost:8082
VERIFIER_API_URL=http://localhost:8083
RECEIPT_SERVICE_URL=http://localhost:8084

# Verification Session Security (Replay Protection)
VERIFICATION_SESSION_TTL_SECONDS=120

# Database & Cache
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trustpass
POSTGRES_PORT=5432
REDIS_PORT=6379

# Frontend Ports
PORT_VERIFIER_PWA=3000
PORT_HOLDER_WALLET=5173
PORT_ISSUER_CONSOLE=5174

# Default Issuer DID (did:key BLS12-381 G2)
DEFAULT_ISSUER_DID=did:key:zUC724vsrMwHvKyqDdHtrh7z2GNe5xbsfgivth466P4vm2iaJLW9kK48DbgKa32yL944yK9k
