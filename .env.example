# TrustPass Environment Configuration Example
# Copy to .env for local deployment. Never commit real secrets.

# Port configurations
PORT_SCHEMA_REGISTRY=8081
PORT_ISSUER_API=8082
PORT_VERIFIER_API=8083
PORT_RECEIPT_SERVICE=8084
PORT_CORE_GRPC=50051

# Database & Redis
DATABASE_URL=postgres://trustpass:trustpass_dev@localhost:5432/trustpass?sslmode=disable
REDIS_URL=redis://localhost:6379

# Issuer Default Identity (Mock Demo)
DEFAULT_ISSUER_DID=did:key:zUC724vsrMwHvKyqDdHtrh7z2GNe5xbsfgivth466P4vm2iaJLW9kK48DbgKa32yL944yK9k
DEFAULT_ISSUER_SEED=13374242

# Verification Session Expiration (seconds)
VERIFICATION_SESSION_TTL_SECONDS=120
