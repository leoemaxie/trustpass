# Multi-stage Dockerfile for TrustPass Issuer API Service (Go)
FROM golang:1.22-alpine AS builder

WORKDIR /app/services
COPY services/go.mod services/go.sum ./
RUN go mod download

COPY services/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/issuer-api ./issuer-api/cmd

FROM alpine:3.20
RUN apk add --no-cache ca-certificates curl
COPY --from=builder /bin/issuer-api /usr/local/bin/issuer-api

ENV PORT=8082
EXPOSE 8082

HEALTHCHECK --interval=5s --timeout=3s --retries=5 \
    CMD curl -f http://localhost:8082/healthz || exit 1

ENTRYPOINT ["issuer-api"]
