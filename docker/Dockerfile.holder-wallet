# Multi-stage Dockerfile for TrustPass Holder Wallet (SvelteKit)
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy shared styles and design tokens referenced via $shared alias
COPY apps/shared ./apps/shared

# Copy holder-wallet app sources and dependencies
COPY apps/holder-wallet ./apps/holder-wallet

WORKDIR /app/apps/holder-wallet
RUN pnpm install --frozen-lockfile
RUN pnpm run build

# Minimal Nginx runtime stage
FROM nginx:alpine

RUN apk add --no-cache curl

COPY docker/nginx-5173.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/holder-wallet/build /usr/share/nginx/html

EXPOSE 5173

HEALTHCHECK --interval=5s --timeout=3s --retries=5 \
    CMD curl -f http://localhost:5173/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
