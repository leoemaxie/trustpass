# Multi-stage Dockerfile for TrustPass Issuer Console (SvelteKit)
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy shared styles and design tokens referenced via $shared alias
COPY apps/shared ./apps/shared

# Copy issuer-console app sources and dependencies
COPY apps/issuer-console ./apps/issuer-console

WORKDIR /app/apps/issuer-console
RUN pnpm install --frozen-lockfile
RUN pnpm run build

# Minimal Nginx runtime stage
FROM nginx:alpine

RUN apk add --no-cache curl

COPY docker/nginx-5174.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/issuer-console/build /usr/share/nginx/html

EXPOSE 5174

HEALTHCHECK --interval=5s --timeout=3s --retries=5 \
    CMD curl -f http://localhost:5174/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
