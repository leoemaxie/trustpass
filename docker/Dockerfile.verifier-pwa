# Dockerfile for TrustPass Verifier PWA (Vanilla JS/HTML)
FROM nginx:alpine

RUN apk add --no-cache curl

COPY docker/nginx-3000.conf /etc/nginx/conf.d/default.conf
COPY apps/verifier-pwa /usr/share/nginx/html
COPY apps/shared /usr/share/nginx/shared

EXPOSE 3000

HEALTHCHECK --interval=5s --timeout=3s --retries=5 \
    CMD curl -f http://localhost:3000/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
