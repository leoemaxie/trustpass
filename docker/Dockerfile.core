# Multi-stage Dockerfile for TrustPass Cryptographic Core (Rust)
FROM rust:1.80-bookworm AS builder

WORKDIR /app

# Install protobuf compiler and build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY core/Cargo.toml core/Cargo.lock* ./
COPY core/src ./src
COPY core/proto ./proto
COPY core/circuits ./circuits

RUN cargo build --release --bin proof-core

# Minimal runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/proof-core /usr/local/bin/proof-core
COPY core/circuits /app/circuits

ENV PORT_CORE=50051
EXPOSE 50051

HEALTHCHECK --interval=5s --timeout=3s --retries=5 \
    CMD curl -f http://localhost:50051/healthz || exit 1

ENTRYPOINT ["proof-core"]
